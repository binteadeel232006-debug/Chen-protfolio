
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="Chen Yi Shan's personal portfolio in English Literature, Linguistics, and Digital Humanities.">

  <title>Chen Yi Shan | Personal Portfolio</title>

  <style>
    :root {
      --pink: #f4a9d2;
      --hot-pink: #e96bb4;
      --blue: #8db9ff;
      --deep-blue: #476fd1;
      --black: #10111b;
      --dark: #191b2b;
      --card: #222438;
      --white: #ffffff;
      --muted: #c5c8d8;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      background: var(--black);
      color: var(--white);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1100px, 90%);
      margin: auto;
    }

    header {
      background: rgba(16, 17, 27, 0.96);
      border-bottom: 1px solid #34364c;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav {
      min-height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      color: var(--pink);
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      font-size: 0.9rem;
    }

    .nav-links a:hover {
      color: var(--pink);
    }

    /* Hero */

    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      padding: 85px 0;
      background:
        radial-gradient(
          circle at 85% 25%,
          #363568 0,
          transparent 38%
        ),
        radial-gradient(
          circle at 12% 80%,
          #512b52 0,
          transparent 35%
        ),
        var(--black);
    }

    .eyebrow,
    .section-label {
      color: var(--pink);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(3rem, 8vw, 6rem);
      line-height: 1.05;
      letter-spacing: -2px;
      margin-bottom: 24px;
    }

    h1 span {
      color: var(--pink);
    }

    .hero p {
      max-width: 650px;
      color: var(--muted);
      font-size: 1.05rem;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      display: inline-block;
      padding: 12px 22px;
      border: 1px solid var(--blue);
      border-radius: 7px;
      font-size: 0.92rem;
      transition: 0.25s;
    }

    .btn.primary {
      background: var(--pink);
      border-color: var(--pink);
      color: var(--black);
      font-weight: bold;
    }

    .btn:hover {
      background: var(--blue);
      border-color: var(--blue);
      color: var(--black);
    }

    section {
      padding: 85px 0;
      scroll-margin-top: 80px;
    }

    h2 {
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 1.2;
      margin-bottom: 22px;
    }

    .intro {
      max-width: 750px;
      color: var(--muted);
      line-height: 1.9;
    }

    /* About */

    .about {
      background: var(--white);
      color: var(--black);
    }

    .about .intro {
      color: #4d4e5e;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 40px;
      align-items: start;
    }

    .about .section-label {
      color: var(--deep-blue);
    }

    .info-card {
      background: #f4edf8;
      padding: 26px;
      border-radius: 12px;
      border-left: 5px solid var(--hot-pink);
    }

    .info-card h3 {
      color: #292344;
      margin-bottom: 12px;
    }

    .info-card p {
      color: #454153;
    }

    /* Focus cards */

    .focus {
      background: var(--dark);
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 35px;
    }

    .card {
      background: var(--card);
      padding: 27px;
      border: 1px solid #383a55;
      border-radius: 12px;
      transition: 0.25s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: var(--pink);
    }

    .card .number {
      font-size: 1.5rem;
      color: var(--pink);
      margin-bottom: 10px;
    }

    .card h3 {
      margin-bottom: 12px;
      font-size: 1.2rem;
    }

    .card p {
      font-size: 0.93rem;
      color: var(--muted);
    }

    /* Roles */

    .roles {
      background: #151622;
    }

    .role-list {
      margin-top: 35px;
      display: grid;
      gap: 18px;
    }

    .role-item {
      background: var(--card);
      padding: 23px;
      border-radius: 10px;
      border-left: 4px solid var(--blue);
    }

    .role-item:nth-child(even) {
      border-left-color: var(--pink);
    }

    .role-item h3 {
      font-size: 1.15rem;
      margin-bottom: 7px;
    }

    .role-item p {
      color: var(--muted);
      font-size: 0.93rem;
    }

    .role-tag {
      display: inline-block;
      margin-top: 12px;
      color: var(--blue);
      font-size: 0.78rem;
      letter-spacing: 0.5px;
    }

    /* Education */

    .education {
      background: #202342;
    }

    .education .section-label {
      color: var(--pink);
    }

    .education-box {
      max-width: 800px;
      margin-top: 28px;
      padding: 30px;
      border: 1px solid #606b9e;
      border-radius: 12px;
      background: rgba(16, 17, 27, 0.35);
    }

    .education-box h3 {
      font-size: 1.5rem;
      margin-bottom: 12px;
    }

    .education-box p {
      color: #d8ddf3;
      line-height: 1.9;
    }

    /* Projects */

    .projects {
      background: var(--white);
      color: var(--black);
    }

    .projects .section-label {
      color: var(--deep-blue);
    }

    .projects .intro {
      color: #4d4e5e;
    }

    .project-card {
      max-width: 820px;
      margin-top: 30px;
      padding: clamp(25px, 5vw, 45px);
      background: var(--dark);
      color: var(--white);
      border-radius: 14px;
      border: 1px solid var(--pink);
    }

    .project-tag {
      display: inline-block;
      padding: 5px 12px;
      background: #34304c;
      color: var(--pink);
      border-radius: 20px;
      font-size: 0.78rem;
      margin-bottom: 18px;
    }

    .project-card h3 {
      font-size: clamp(1.7rem, 4vw, 2.6rem);
      line-height: 1.25;
      margin-bottom: 15px;
    }

    .project-card p {
      color: var(--muted);
      margin-bottom: 25px;
    }

    /* Skills */

    .skills {
      background: var(--dark);
    }

    .skill-list {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .skill {
      padding: 9px 15px;
      border: 1px solid #4a4d6b;
      border-radius: 7px;
      background: #25273b;
      color: #e5e6f3;
      font-size: 0.88rem;
    }

    .skill:nth-child(odd) {
      border-color: #895477;
    }

    /* Contact */

    .contact {
      text-align: center;
      background:
        radial-gradient(
          ellipse at center,
          #333765,
          var(--black) 70%
        );
    }

    .contact .intro {
      margin: 0 auto 30px;
    }

    .contact .buttons {
      justify-content: center;
    }

    footer {
      padding: 25px 15px;
      text-align: center;
      color: var(--muted);
      border-top: 1px solid #34364c;
      font-size: 0.85rem;
    }

    footer span {
      color: var(--pink);
    }

    @media (max-width: 760px) {
      nav {
        padding: 16px 0;
        align-items: flex-start;
        flex-direction: column;
      }

      .nav-links {
        gap: 12px;
      }

      .about-grid,
      .card-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        min-height: 75vh;
      }

      section {
        padding: 65px 0;
      }
    }
  </style>
</head>

